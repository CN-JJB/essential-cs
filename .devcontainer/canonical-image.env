# Canonical environment immutable pin — Issue #150 (V-147-02), governance D-032.
#
# THE PIN IS CANONICAL_IMAGE_DIGEST.
#
# A registry manifest/content digest is content-addressed: as long as the
# repository-owned GHCR package exists, `CANONICAL_IMAGE_REF@CANONICAL_IMAGE_DIGEST`
# retrieves the *same* bytes forever, regardless of when, where, or on which
# hosted runner it is pulled. Nothing else in this repository is a canonical
# environment identity:
#
#   registry digest (this file)   -> the pin
#   Docker local image ID         -> daemon-local and ephemeral; NOT the pin
#   mutable tags (:candidate etc.) -> convenience labels; NOT the pin
#   git commit / workflow SHA      -> source revision; NOT the pin
#   GitHub-hosted runner image     -> moving execution substrate; NOT the pin
#
# Changing this digest moves the accepted canonical environment. It may only be
# done through a reviewed PR following the refresh runbook in
# .devcontainer/CANONICAL_ENVIRONMENT.md (§7). A mutable-tag rebuild must never
# silently move it: .github/workflows/publish-canonical-environment.yml cannot
# write this file, and the canonical CI lanes refuse to run if the digest is
# unset, malformed, or no longer matches the published registry content.
#
# The digest below is the accepted canonical environment identity. It was built
# from this repository's own recipe and published to the repository-owned GHCR
# package. It is retrievable anonymously (credential-free) and by the
# repository's GITHUB_TOKEN; both paths are recorded in the implementation report.
# The all-zero sentinel (sha256:0000...0000) means "not yet published": CI lanes
# and the pull helper fail closed on it, and the guarded bootstrap path in the
# publication workflow is the only consumer that treats it as "publish first".

CANONICAL_IMAGE_REF=ghcr.io/cn-jjb/essential-cs/canonical
CANONICAL_IMAGE_DIGEST=sha256:766ce07ba3073cc28049ff07d6d4f643bd6e3cc7a7967a3ebd2bb8738219e460
CANONICAL_IMAGE_PLATFORM=linux/amd64

# Recipe identity this digest was built from. `canonical-image-pull.sh` asserts
# the committed Dockerfile still hashes to this blob, so editing the recipe
# without refreshing the pin fails closed instead of silently drifting.
CANONICAL_IMAGE_SOURCE_DOCKERFILE=.devcontainer/Dockerfile
CANONICAL_IMAGE_SOURCE_DOCKERFILE_BLOB=51198ea12c3c9ddfa18a2246bddef491ea729559
CANONICAL_IMAGE_SOURCE_BASE_REF=ubuntu:24.04
CANONICAL_IMAGE_SOURCE_BASE_DIGEST=sha256:224a1869083a311ef3f13648a154ba79832fbef6364d31493642ca03082da254

# Provenance of the publication that produced CANONICAL_IMAGE_DIGEST. These are
# informational audit fields only; they are NOT identity and are never used to
# resolve the image. `canonical-image-pull.sh` deliberately does not depend on
# them: retrieval by digest works even if every field below is stale.
CANONICAL_IMAGE_PUBLISHED_AT=2026-09-12T04:36:04Z
CANONICAL_IMAGE_PUBLISH_RUN_ID=34673360717
CANONICAL_IMAGE_PUBLISH_SOURCE_SHA=25804b02cdd89bc3e2ff386aaf60f7c0b41b9032
